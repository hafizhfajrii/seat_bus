# Kosongkan untuk memakai SQLite lokal (data/transit.db) saat development.
# Di Vercel, hubungkan Neon / Supabase / Vercel Postgres lalu set DATABASE_URL:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Kunci rahasia untuk menandatangani cookie sesi admin (wajib diisi teks acak panjang di production)
AUTH_SECRET=ganti-dengan-teks-acak-minimal-32-karakter

